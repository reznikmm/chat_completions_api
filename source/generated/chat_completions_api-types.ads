            null;
      end case;
   end record;

   type CompletionUsage_prompt_tokens_details is record
      audio_tokens  : Optional_Integer_64;
      --  Audio input tokens present in the prompt.
      cached_tokens : Optional_Integer_64;
      --  Cached tokens present in the prompt.
   end record;

   type Optional_CompletionUsage_prompt_tokens_details
     (Is_Set : Boolean := False)
