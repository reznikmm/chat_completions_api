            null;
      end case;
   end record;

   type CompletionUsage is record
      completion_tokens         : Integer_64;
      --  Number of tokens in the generated completion.
      prompt_tokens             : Integer_64;
      --  Number of tokens in the prompt.
      total_tokens              : Integer_64;
      --  Total number of tokens used in the request (prompt + completion).
      completion_tokens_details :
        Optional_CompletionUsage_completion_tokens_details;
      --  Breakdown of tokens used in a completion.
      prompt_tokens_details     :
        Optional_CompletionUsage_prompt_tokens_details;
      --  Breakdown of tokens used in the prompt.
   end record;

   type Optional_CompletionUsage (Is_Set : Boolean := False) is record
      case Is_Set is
         when True =>
            Value : CompletionUsage;

         when False =>
            null;
      end case;
   end record;

   type CreateChatCompletionResponse is record
      id                 : VSS.Strings.Virtual_String;
      --  A unique identifier for the chat completion.
      choices            : ChatCompletionChoice_Vector;
      --  A list of chat completion choices. Can be more than one if `n` is greater than 1.
      created            : Integer_64;
      --  The Unix timestamp (in seconds) of when the chat completion was created.
      model              : VSS.Strings.Virtual_String;
      --  The model used for the chat completion.
      system_fingerprint : VSS.Strings.Virtual_String;
      --  This fingerprint represents the backend configuration that the model runs with.
      --
      --  Can be used in conjunction with the `seed` request parameter to understand when backend changes have been made that might impact determinism.
      usage              : Optional_CompletionUsage;
   end record;

